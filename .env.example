# Yuca Backend — environment variables
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# On the Azure VM this file lives at /home/azureuser/YUCA_Backend_Service/.env
# and is git-ignored (the deploy does `git reset --hard` and must not touch it).

# ---- Core ----
NODE_ENV=production            # development | production
PORT=5001                      # API port (deploy health check hits :5001/health)

# ---- Database ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ---- Auth ----
# Use a long random string (e.g. `openssl rand -base64 48`). Rotating this logs everyone out.
JWT_SECRET=replace-with-a-long-random-secret

# ---- Razorpay (payments) ----
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Must match the webhook secret configured in the Razorpay dashboard (used to verify the HMAC).
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Email ----
# config/email.js uses the EMAIL_* (Gmail service) transport by default; the SMTP_*
# block is the alternative for a custom SMTP server. Set the group you use.
# Gmail (default): create an App Password, not your account password.
EMAIL_SERVICE=gmail
EMAIL_USER=you@yourdomain.com
EMAIL_PASSWORD=your-app-password

# Custom SMTP (alternative to the Gmail service above)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false              # true for port 465, false otherwise
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your-smtp-password
